			"type": "http",
			"url": "http://localhost:3002"
		},
		"ssh-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"ssh-mcp",
				"--",
				"--host=157.90.236.115",
				"--port=22",
				"--user=alex",
				"--password=TiTp4@lex",
				"--sudoPassword=TiTp4@lex",
				"--timeout=120000",
				"--maxChars=none"
			]
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest",
				"--vision"
			],
			"type": "stdio"
		},
		"angular-cli": {
			"command": "npx",
			"args": [
				"-y",
				"@angular/cli",
				"mcp"
			]
		},
		"azure-deploy": {
			"command": "npx",
			"args": [
				"-y",
				"@azure/mcp@latest",
				"server",
				"start"
			],
			"type": "stdio"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"microsoft-learn": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		},
		"work-iq": {
			"command": "npx",
			"args": [
				"-y",
				"@microsoft/workiq",
				"mcp"
			]
		},
		"chrome-devtools": {
			"command": "npx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest"
			],
			"type": "stdio"
		},
		"microsoft-foundry": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--prerelease=allow",
				"--from",
				"git+https://github.com/azure-ai-foundry/mcp-foundry.git",
				"run-azure-ai-foundry-mcp"
			]
		},
		"labs-mcp-map": {
			"type": "http",
			"url": "http://localhost:3003/mcp"
		},
		"pdf": {
			"command": "npx",
			"args": [
				"-y",
				"--silent",
				"--registry=https://registry.npmjs.org/",
				"@modelcontextprotocol/server-pdf",
				"--stdio"
			],
			"type": "stdio"
		},
		"secrets-mcp": {
			"type": "http",
			"url": "https://store.integrations.at/mcp",
			"headers": {
				"X-API-Key": "secmcp_13fb1c6a780690ceacdd57bc37306070af019e4a68e4745c"
			}
		},
		"worktime-mcp": {
			"type": "http",
			"url": "https://worktime-mcp.integrations.at/mcp",
			"headers": {
				"X-API-Key": "${WORKTIME_MCP_KEY}"
			}
		}
	},
	"inputs": []
