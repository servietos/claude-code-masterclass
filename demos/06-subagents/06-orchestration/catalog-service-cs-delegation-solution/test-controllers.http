@baseUrl = http://localhost:5000

### Config Controller Tests

### Get Config
GET {{baseUrl}}/config
Content-Type: application/json

### Get Environment Variables
GET {{baseUrl}}/config/getEnvVars
Content-Type: application/json

### Get Feature Flags
GET {{baseUrl}}/config/getFeatureFlags
Content-Type: application/json

### Food Controller Tests

### Get All Food Items
GET {{baseUrl}}/food
Content-Type: application/json

### Get Food by ID (e.g., ID 1)
GET {{baseUrl}}/food/1
Content-Type: application/json

### Create Food Item
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Pizza",
  "description": "Delicious cheese pizza",
  "price": 12.99
}

### Update Food Item
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 1,
  "name": "Margherita Pizza",
  "description": "Classic Italian pizza with fresh mozzarella",
  "price": 14.99
}

### Delete Food Item (e.g., ID 1)
DELETE {{baseUrl}}/food/1
Content-Type: application/json

### Create Food Item - valid payload (expect 201 Created)
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Lasagne",
  "price": 16.50,
  "inStock": 25,
  "pictureUrl": "https://example.com/images/lasagne.jpg",
  "description": "Layered pasta with beef ragu"
}

### Create Food Item - blank name (expect 400 Bad Request)
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "",
  "price": 16.50,
  "inStock": 25,
  "pictureUrl": "https://example.com/images/lasagne.jpg",
  "description": "Layered pasta with beef ragu"
}

### Create Food Item - negative price (expect 400 Bad Request)
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Lasagne",
  "price": -16.50,
  "inStock": 25,
  "pictureUrl": "https://example.com/images/lasagne.jpg",
  "description": "Layered pasta with beef ragu"
}

### Create Food Item - negative InStock (expect 400 Bad Request)
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Lasagne",
  "price": 16.50,
  "inStock": -5,
  "pictureUrl": "https://example.com/images/lasagne.jpg",
  "description": "Layered pasta with beef ragu"
}

### Update Food Item - valid payload (expect 200 OK)
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 1,
  "name": "Lasagne al Forno",
  "price": 18.90,
  "inStock": 30,
  "pictureUrl": "https://example.com/images/lasagne-al-forno.jpg",
  "description": "Oven-baked lasagne with bechamel"
}

### Update Food Item - unknown ID (expect 404 Not Found)
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 9999,
  "name": "Lasagne al Forno",
  "price": 18.90,
  "inStock": 30,
  "pictureUrl": "https://example.com/images/lasagne-al-forno.jpg",
  "description": "Oven-baked lasagne with bechamel"
}

### Update Food Item - negative price (expect 400 Bad Request)
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 1,
  "name": "Lasagne al Forno",
  "price": -18.90,
  "inStock": 30,
  "pictureUrl": "https://example.com/images/lasagne-al-forno.jpg",
  "description": "Oven-baked lasagne with bechamel"
}

### Delete Food Item - existing ID (expect 204 No Content)
DELETE {{baseUrl}}/food/1
Content-Type: application/json

### Delete Food Item - unknown ID (expect 404 Not Found)
DELETE {{baseUrl}}/food/9999
Content-Type: application/json

### Get Food by ID - unknown ID (expect 404 Not Found)
GET {{baseUrl}}/food/9999
Content-Type: application/json
