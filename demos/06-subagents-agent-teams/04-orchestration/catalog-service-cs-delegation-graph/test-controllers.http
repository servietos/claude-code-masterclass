@baseUrl = http://localhost:5000

### Config Controller Tests

### Get Config
GET {{baseUrl}}/config
Content-Type: application/json

### Get Environment Variables
GET {{baseUrl}}/config/getEnvVars
Content-Type: application/json

### Get Feature Flags
GET {{baseUrl}}/config/getFeatureFlags
Content-Type: application/json

### Food Controller Tests

### Get All Food Items
GET {{baseUrl}}/food
Content-Type: application/json

### Get Food by ID (e.g., ID 1)
GET {{baseUrl}}/food/1
Content-Type: application/json

### Create Food Item
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Pizza",
  "description": "Delicious cheese pizza",
  "price": 12.99
}

### Update Food Item
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 1,
  "name": "Margherita Pizza",
  "description": "Classic Italian pizza with fresh mozzarella",
  "price": 14.99
}

### Delete Food Item (e.g., ID 1)
DELETE {{baseUrl}}/food/1
Content-Type: application/json

### Food Controller Validation Tests

### Create Food Item - valid payload - expect 201 Created with Location header
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Lasagne",
  "price": 15.5,
  "inStock": 20,
  "pictureUrl": "https://example.com/img/lasagne.jpg",
  "description": "Layered pasta with beef ragu"
}

### Create Food Item - blank name - expect 400 Bad Request with ProblemDetails
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "   ",
  "price": 15.5,
  "inStock": 20,
  "pictureUrl": "https://example.com/img/lasagne.jpg",
  "description": "Name is whitespace only"
}

### Create Food Item - negative price - expect 400 Bad Request with ProblemDetails
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Lasagne",
  "price": -1.0,
  "inStock": 20,
  "pictureUrl": "https://example.com/img/lasagne.jpg",
  "description": "Price is negative"
}

### Create Food Item - negative InStock - expect 400 Bad Request with ProblemDetails
POST {{baseUrl}}/food
Content-Type: application/json

{
  "id": 0,
  "name": "Lasagne",
  "price": 15.5,
  "inStock": -5,
  "pictureUrl": "https://example.com/img/lasagne.jpg",
  "description": "InStock is negative"
}

### Update Food Item - valid payload - expect 200 OK with updated item
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 1,
  "name": "Lasagne al Forno",
  "price": 16.9,
  "inStock": 18,
  "pictureUrl": "https://example.com/img/lasagne-al-forno.jpg",
  "description": "Baked lasagne with bechamel"
}

### Update Food Item - unknown ID 9999 - expect 404 Not Found
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 9999,
  "name": "Ghost Dish",
  "price": 9.9,
  "inStock": 3,
  "pictureUrl": "https://example.com/img/ghost.jpg",
  "description": "No item with this ID exists"
}

### Update Food Item - negative price - expect 400 Bad Request with ProblemDetails
PUT {{baseUrl}}/food
Content-Type: application/json

{
  "id": 1,
  "name": "Lasagne al Forno",
  "price": -0.5,
  "inStock": 18,
  "pictureUrl": "https://example.com/img/lasagne-al-forno.jpg",
  "description": "Price is negative"
}

### Delete Food Item - existing ID 2 - expect 204 No Content
DELETE {{baseUrl}}/food/2
Content-Type: application/json

### Delete Food Item - unknown ID 9999 - expect 404 Not Found
DELETE {{baseUrl}}/food/9999
Content-Type: application/json

### Get Food by ID - unknown ID 9999 - expect 404 Not Found
GET {{baseUrl}}/food/9999
Content-Type: application/json
