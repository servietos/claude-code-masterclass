# Build stage: download Hugo Extended and produce the static site
FROM golang:1.24 AS hugo
RUN apt-get update && apt-get install -y wget && \
    wget -q https://github.com/gohugoio/hugo/releases/download/v0.164.0/hugo_extended_0.164.0_linux-amd64.deb && \
    dpkg -i hugo_extended_0.164.0_linux-amd64.deb
WORKDIR /site
COPY . .
RUN hugo --minify

# Runtime stage: serve the built site with nginx
FROM nginx:1.27-alpine
COPY --from=hugo /site/public /usr/share/nginx/html
