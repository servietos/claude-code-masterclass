{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "notes-toolkit",
  "version": "0.1.0",
  "description": "Extract, prioritise, and report on TODO/FIXME/NOTE comments across a codebase.",
  "author": {
    "name": "Claude Code Masterclass"
  },
  "license": "MIT",
  "keywords": ["notes", "todo", "triage"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scope-gate.sh\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "notes-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/requirements.txt",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/server.py"
      ]
    }
  }
}
